    <!-- plugins -->
    <plugin filename="libArduPilotPlugin.so" name="ArduPilotPlugin">
     <fdm_addr>127.0.0.1</fdm_addr>
     <fdm_port_in>9012</fdm_port_in>
     <fdm_port_out>9013</fdm_port_out>
     <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
     <lock_step>0</lock_step>
     <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
     <imuName>iris_with_standoffs::imu_link::imu_sensor</imuName>
     <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
               <control channel="0">
      <jointName>iris_with_standoffs::rotor_0_joint</jointName>
      <useForce>1</useForce>
      <multiplier>838</multiplier>
      <offset>0</offset>
      <servo_min>1100</servo_min>
      <servo_max>1900</servo_max>
      <type>VELOCITY</type>
      <p_gain>0.20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>2.5</cmd_max>
      <cmd_min>-2.5</cmd_min>
     </control>
     <control channel="1">
      <jointName>iris_with_standoffs::rotor_1_joint</jointName>
      <useForce>1</useForce>
      <multiplier>838</multiplier>
      <offset>0</offset>
      <servo_min>1100</servo_min>
      <servo_max>1900</servo_max>
      <type>VELOCITY</type>
      <p_gain>0.20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>2.5</cmd_max>
      <cmd_min>-2.5</cmd_min>
     </control>
     <control channel="2">
      <jointName>iris_with_standoffs::rotor_2_joint</jointName>
      <useForce>1</useForce>
      <multiplier>-838</multiplier>
      <offset>0</offset>
      <servo_min>1100</servo_min>
      <servo_max>1900</servo_max>
      <type>VELOCITY</type>
      <p_gain>0.20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>2.5</cmd_max>
      <cmd_min>-2.5</cmd_min>
     </control>
     <control channel="3">
      <jointName>iris_with_standoffs::rotor_3_joint</jointName>
      <useForce>1</useForce>
      <multiplier>-838</multiplier>
      <offset>0</offset>
      <servo_min>1100</servo_min>
      <servo_max>1900</servo_max>
      <type>VELOCITY</type>
      <p_gain>0.20</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>2.5</cmd_max>
      <cmd_min>-2.5</cmd_min>
     </control>
    </plugin>	

    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_0</link_name>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
