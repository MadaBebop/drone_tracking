# Parametri applicati al SITL in aggiunta a Tools/autotest/default_params/gazebo-iris.parm
# (ArduPilot accetta piu file in --defaults, separati da virgola).

# ATTENZIONE al nome: in questa versione di ArduPilot il parametro NON si chiama
# ARMING_CHECK, che non esiste e viene ignorato in silenzio lasciando tutti i
# controlli attivi. Si chiama ARMING_SKIPCHK e ha logica inversa: 1 = salta tutto.
# Senza, l'arming fallisce con "Arm: Gyros inconsistent" o "Accels inconsistent",
# perche gli IMU simulati divergono quando la fisica singhiozza.
ARMING_SKIPCHK 1

# --- Fluidita della navigazione ---
# Questi valori erano stati alzati per rendere il drone piu reattivo
# (WP_SPD 10, WP_ACC 5, WP_JERK 8, PSC_JERK_NE 15, ATC_ANGLE_MAX 40), ma la
# misura non aveva mostrato alcun guadagno: il rapporto fra velocita comandata e
# velocita eseguita restava invariato. In compenso rendevano il volo nervoso, con
# oscillazioni visibili nei trasferimenti fra waypoint e, di riflesso, un
# ondeggiamento dell'inquadratura, dato che la telecamera e solidale al corpo.
#
# Il circuito di pattugliamento e un quadrato di 20 m: 10 m/s significa arrivare
# sul waypoint troppo lanciati per fermarsi senza sorpassarlo.
WP_SPD 4.0
WP_ACC 2.0
WP_JERK 3.0
PSC_JERK_NE 8.0

# Meno inclinazione massima: il drone e comunque abbondantemente piu veloce del
# bersaglio, e ogni grado di rollio o beccheggio trasla l'immagine.
ATC_ANGLE_MAX 25.0
