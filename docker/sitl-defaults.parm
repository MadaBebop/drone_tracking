# Parametri applicati al SITL in aggiunta a Tools/autotest/default_params/gazebo-iris.parm
# (ArduPilot accetta piu file in --defaults, separati da virgola).
#
# Il backend JSON con Gazebo fallisce spesso i prearm check sui sensori simulati.
# Impostarlo qui evita di doverlo fare a runtime: via MAVROS il set fallisce
# finche il pull dei parametri dal firmware non e completo, e il timing non e
# prevedibile.
# ATTENZIONE al nome: in questa versione di ArduPilot il parametro NON si chiama
# ARMING_CHECK, che non esiste e viene ignorato in silenzio lasciando tutti i
# controlli attivi. Si chiama ARMING_SKIPCHK e ha logica inversa: 1 = salta tutto.
# Senza, l'arming fallisce con "Arm: Gyros inconsistent" o "Accels inconsistent",
# perche gli IMU simulati divergono quando la fisica singhiozza.
ARMING_SKIPCHK 1

# --- Reattivita in GUIDED ---
# I default sono tarati per voli di trasferimento dolci, non per inseguire un
# bersaglio che cambia direzione di continuo. Il freno peggiore e il jerk: a
# 1.0 m/s^3 servono 2.5 secondi per arrivare all'accelerazione massima, quindi il
# drone passa l'inseguimento a "prendere l'abbrivio" e arriva sempre tardi.
#
# ATTENZIONE ai nomi: da Copter 4.7 sono stati rinominati in unita SI.
# Su firmware precedenti si chiamano WPNAV_ACCEL (cm/s^2), WPNAV_SPEED (cm/s)
# e ANGLE_MAX (centesimi di grado), e queste righe verranno ignorate.
WP_ACC 5.0
WP_JERK 8.0
PSC_JERK_NE 15.0
ATC_ANGLE_MAX 40.0
